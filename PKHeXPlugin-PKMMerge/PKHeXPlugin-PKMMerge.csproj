<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" Version="26.8.26" />
  </ItemGroup>

  <!-- Kept here rather than in the git-ignored .csproj.user so every clone gets "View Designer". -->
  <ItemGroup>
    <Compile Update="FormDiff.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="HexCompareForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <PKHeXOutputDir>$(MSBuildProjectDirectory)\..\..\PKHeX\PKHeX.WinForms\bin\Debug\net10.0-windows\win-x64</PKHeXOutputDir>
  </PropertyGroup>

  <!-- A warning, not an error: a failed build would also stop the WinForms designer from loading. -->
  <Target Name="CopyPluginToPKHeX" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true'">
    <Warning Condition="!Exists('$(PKHeXOutputDir)\PKHeX.exe')" Text="PKHeX.exe was not found in $(PKHeXOutputDir); the plugin was not copied. Build PKHeX.WinForms in Debug first." />
    <MakeDir Condition="Exists('$(PKHeXOutputDir)\PKHeX.exe')" Directories="$(PKHeXOutputDir)\plugins" />
    <Copy Condition="Exists('$(PKHeXOutputDir)\PKHeX.exe')" SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PKHeXOutputDir)\plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
